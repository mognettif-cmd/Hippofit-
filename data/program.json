  "doseNotes": {
    "main": "Schwere Grundübung. Steht immer am Anfang. Ab Phase 2 schwer (≈ 80 % 1RM), aber nie bis zum Versagen.",
    "power": "So schnell wie möglich in der Aufwärtsbewegung. Höchstens 24 Wiederholungen pro Übung und Einheit. Satz beenden, sobald es langsamer wird.",
    "carry": "Zeit pro Seite bei einseitigen Varianten. Gewicht so wählen, dass die Haltung bis zum Schluss sauber bleibt.",
    "pf": "Dazu gehört das tägliche Beckenboden-Häkchen (3 × 8–12 maximale Kontraktionen pro Tag, 16 Wochen).",
    "rir": "RIR = Wiederholungen in Reserve. RIR 2 heisst: noch 2 saubere Wiederholungen wären möglich gewesen."
  },

  "phases": [
    {
      "id": 1, "name": "Basis", "weeks": "3–4",
      "goal": "Technik, Sehnen und Gelenke vorbereiten, Rumpf und Beckenboden aufbauen, lockere Grundlagenausdauer.",
      "strength": "2–3 Sätze × 10–15 Wdh, RIR 3–4",
      "endurance": "2 × locker (Z1–2), keine harten Einheiten",
      "impactAllowed": 1,
      "exitCriteria": [
        "Alle Grundübungen sauber ausgeführt (Selbst-Check)",
        "Mindestens 6 Krafteinheiten in dieser Phase",
        "Beckenboden-Ampel nicht rot"
      ],
      "refs": [1, 2, 20]
    },
    {
      "id": 2, "name": "Kraft", "weeks": "6",
      "goal": "Schwere Beinkraft, einbeinige Stabilität, exzentrische Bergab-Kraft, Tragen.",
      "strength": "3–4 Sätze × 5–8 Wdh, RIR 2–3",
      "endurance": "2 × locker + 1 × Bergintervall oder Tempo",
      "impactAllowed": 1,
      "exitCriteria": [
        "Geschätztes 1RM in Kniebeuge/Split Squat gestiegen oder Gewicht in den Hauptübungen erhöht",
        "Mindestens 10 Krafteinheiten in dieser Phase",
        "Testbatterie gemacht"
      ],
      "refs": [1, 5, 6, 7, 11, 20]
    },
    {
      "id": 3, "name": "Kraft & Power", "weeks": "4–6",
      "goal": "Schnellkraft mit Kettlebell-Swing, explosiven Step-ups und ersten Sprüngen mit wenig Aufprall. Die schwere Kraft bleibt.",
      "strength": "3 × 4–6 schwer + 3 × 5 explosiv",
      "endurance": "wie Phase 2 + 1 × lang mit Höhenmetern",
      "impactAllowed": 2,
      "exitCriteria": [
        "Eintrittstest Phase 4 bestanden (alle Punkte ohne Symptome)",
        "Beckenboden-Ampel grün"
      ],
      "refs": [1, 5, 6, 12, 13]
    },
    {
      "id": 4, "name": "Reaktivkraft & Plyometrie", "weeks": "6–8",
      "goal": "Kurze Bodenkontakte, Hüpfen, Sprunglauf, Drop Jumps vom kleinen Step. Kombiniert mit schwerer Kraft – das wirkt am stärksten.",
      "strength": "2–3 × 4–6 schwer (Erhalt) + Plyometrie",
      "endurance": "wie Phase 3, Bergab-Technik dazu",
      "impactAllowed": 3,
      "exitCriteria": [
        "Mindestens 12 Plyometrie-Einheiten (Stufe 3 erreicht)",
        "Testbatterie gemacht"
      ],
      "refs": [5, 6, 7, 9, 10]
    },
    {
      "id": 5, "name": "Wahl-Modus", "weeks": "laufend",
      "goal": "Alle Blöcke frei wählbar. Die App achtet auf die Wochen-Balance und erinnert alle 6 Wochen an die Testbatterie.",
      "strength": "gemischt, mind. 2 × Kraft pro Woche",
      "endurance": "pyramidal: ~75–80 % locker",
      "impactAllowed": 3,
      "exitCriteria": [],
      "refs": [1, 2, 15]
    }
  ],

